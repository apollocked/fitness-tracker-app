# Hide platform folders and typical generated files from GitHub language statistics
android/** linguist-vendored
ios/** linguist-vendored
linux/** linguist-vendored
macos/** linguist-vendored
windows/** linguist-vendored
web/** linguist-vendored
build/** linguist-vendored
.idea/** linguist-vendored
.vscode/** linguist-vendored

# Also mark them as generated so they are collapsed in Pull Requests
android/** linguist-generated=true
ios/** linguist-generated=true
linux/** linguist-generated=true
macos/** linguist-generated=true
windows/** linguist-generated=true
web/** linguist-generated=true

# Ignore other typical system/build files
Makefile linguist-vendored
CMakeLists.txt linguist-vendored
*.c linguist-vendored
*.cpp linguist-vendored
*.cc linguist-vendored
*.h linguist-vendored
*.swift linguist-vendored
*.java linguist-vendored
*.kt linguist-vendored
*.xml linguist-vendored

# Explicitly tell GitHub that .dart files are the priority
*.dart linguist-detectable=true
